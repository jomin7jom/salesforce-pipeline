{
  "properties": {
    "description": "Salesforce Opportunity -> ADLS salesforce-opportunity-raw/opportunity/yyyy/MM/dd/*.parquet -> (Snowpipe) SFDC_OPPORTUNITY_RAW -> wait for load -> CALL SP_MERGE_SFDC_OPPORTUNITY() -> SFDC_OPPORTUNITY",
    "parameters": {
      "soqlQuery": {
        "type": "string",
        "defaultValue": "SELECT Id, Name, AccountId, Amount, TotalOpportunityQuantity, CloseDate, StageName, Probability, Type, LeadSource, IsClosed, IsWon, Description, CreatedDate, LastModifiedDate FROM Opportunity WHERE Name LIKE 'SNOWPIPE-TEST-OPP-%'"
      }
    },
    "activities": [
      {
        "name": "Copy_Opportunity_To_ADLS",
        "type": "Copy",
        "policy": { "timeout": "0.01:00:00", "retry": 1, "retryIntervalInSeconds": 60 },
        "inputs":  [ { "referenceName": "DS_SFDC_OPPORTUNITY", "type": "DatasetReference" } ],
        "outputs": [
          {
            "referenceName": "DS_ADLS_SFDC_OPPORTUNITY_PARQUET",
            "type": "DatasetReference",
            "parameters": {
              "folderPath": {
                "value": "@concat('opportunity/', formatDateTime(pipeline().TriggerTime, 'yyyy/MM/dd'))",
                "type": "Expression"
              },
              "fileName": {
                "value": "@concat('opportunity_', formatDateTime(pipeline().TriggerTime, 'yyyyMMdd_HHmmss'), '_', pipeline().RunId, '.parquet')",
                "type": "Expression"
              }
            }
          }
        ],
        "typeProperties": {
          "source": {
            "type": "SalesforceV2Source",
            "SOQLQuery": { "value": "@pipeline().parameters.soqlQuery", "type": "Expression" },
            "includeDeletedObjects": false
          },
          "sink": {
            "type": "ParquetSink",
            "storeSettings":  { "type": "AzureBlobFSWriteSettings" },
            "formatSettings": { "type": "ParquetWriteSettings" }
          },
          "enableStaging": false,
          "translator": { "type": "TabularTranslator", "typeConversion": true }
        }
      },
      {
        "name": "Until_Snowpipe_Loaded",
        "description": "Poll COPY_HISTORY for this run's file (file name contains the RunId). Exits immediately if the copy wrote 0 rows.",
        "type": "Until",
        "dependsOn": [ { "activity": "Copy_Opportunity_To_ADLS", "dependencyConditions": [ "Succeeded" ] } ],
        "typeProperties": {
          "expression": {
            "value": "@or(equals(activity('Copy_Opportunity_To_ADLS').output.rowsCopied, 0), greater(int(activity('Check_Snowpipe_Load').output.resultSets[0].rows[0].LOADED), 0))",
            "type": "Expression"
          },
          "timeout": "0.00:15:00",
          "activities": [
            {
              "name": "Wait_30s",
              "type": "Wait",
              "typeProperties": { "waitTimeInSeconds": 30 }
            },
            {
              "name": "Check_Snowpipe_Load",
              "type": "Script",
              "dependsOn": [ { "activity": "Wait_30s", "dependencyConditions": [ "Succeeded" ] } ],
              "policy": { "timeout": "0.00:05:00", "retry": 2, "retryIntervalInSeconds": 30 },
              "linkedServiceName": { "referenceName": "LS_SNOWFLAKE", "type": "LinkedServiceReference" },
              "typeProperties": {
                "scripts": [
                  {
                    "type": "Query",
                    "text": {
                      "value": "SELECT COUNT_IF(UPPER(STATUS) = 'LOADED') AS LOADED, COUNT_IF(UPPER(STATUS) IN ('LOAD FAILED', 'PARTIALLY LOADED')) AS FAILED, COALESCE(MAX(FIRST_ERROR_MESSAGE), '') AS FIRST_ERROR FROM TABLE(LEARNING_DB.INFORMATION_SCHEMA.COPY_HISTORY(TABLE_NAME => 'LEARNING_DB.DEMO.SFDC_OPPORTUNITY_RAW', START_TIME => DATEADD(hour, -3, CURRENT_TIMESTAMP()))) WHERE FILE_NAME ILIKE '%@{pipeline().RunId}%'",
                      "type": "Expression"
                    }
                  }
                ]
              }
            },
            {
              "name": "If_Snowpipe_Load_Failed",
              "type": "IfCondition",
              "dependsOn": [ { "activity": "Check_Snowpipe_Load", "dependencyConditions": [ "Succeeded" ] } ],
              "typeProperties": {
                "expression": {
                  "value": "@greater(int(activity('Check_Snowpipe_Load').output.resultSets[0].rows[0].FAILED), 0)",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "Fail_Snowpipe_Load",
                    "type": "Fail",
                    "typeProperties": {
                      "message": {
                        "value": "@concat('Snowpipe failed to load the file for run ', pipeline().RunId, ': ', activity('Check_Snowpipe_Load').output.resultSets[0].rows[0].FIRST_ERROR)",
                        "type": "Expression"
                      },
                      "errorCode": "SNOWPIPE_LOAD_FAILED"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Merge_To_Target",
        "description": "Incremental MERGE SFDC_OPPORTUNITY_RAW_STREAM -> SFDC_OPPORTUNITY",
        "type": "Script",
        "dependsOn": [ { "activity": "Until_Snowpipe_Loaded", "dependencyConditions": [ "Succeeded" ] } ],
        "policy": { "timeout": "0.00:15:00", "retry": 1, "retryIntervalInSeconds": 60 },
        "linkedServiceName": { "referenceName": "LS_SNOWFLAKE", "type": "LinkedServiceReference" },
        "typeProperties": {
          "scripts": [ { "type": "Query", "text": "CALL LEARNING_DB.DEMO.SP_MERGE_SFDC_OPPORTUNITY()" } ]
        }
      }
    ]
  }
}
